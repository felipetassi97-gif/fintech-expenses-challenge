DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintech?schema=public"
# Optional direct connection for Prisma migrations when DATABASE_URL uses Neon’s pooler.
# Leave unset for local PostgreSQL; Prisma CLI will fall back to DATABASE_URL.
# DIRECT_URL=
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PORT=3000
JWT_SECRET="replace-with-a-long-random-secret"
